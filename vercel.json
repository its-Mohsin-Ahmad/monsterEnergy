{
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    { "src": "/assets/(.*)", "headers": { "Cache-Control": "public, max-age=31536000, immutable" } },
    { "src": "/favicon.ico", "headers": { "Cache-Control": "public, max-age=31536000" } },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}